# Include your project-specific ignores in this file
# Read about how to use .gitignore: https://help.github.com/articles/ignoring-files
# Useful .gitignore templates: https://github.com/github/gitignore
node_modules
dist
.cache
# Merged and cleaned prooduct data
src/data/*

# Search index (generated)
src/index/*

# Raw product data (large generated/source files — not committed)
# Exception: committed source snapshots (ebay, amazon, walmart CSVs) are tracked explicitly
json/*.json
json/*.csv
!json/amazon-products.csv
!json/walmart-products.csv
!json/ebay-products.json

# Python cache
__pycache__/
*.pyc